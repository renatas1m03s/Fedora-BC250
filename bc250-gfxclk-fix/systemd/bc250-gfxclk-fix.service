[Unit]
Description=BC-250 GPU frequency display fix (overlays correct gfxclk onto amdgpu hwmon freq1_input)
# The After/Wants on cyan-skillfish-governor-smu.service is optional startup
# ordering for systems that also run that governor; systemd ignores it
# harmlessly if the unit doesn't exist on your system.
After=multi-user.target cyan-skillfish-governor-smu.service
Wants=cyan-skillfish-governor-smu.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bc250_gfxclk_fix.py --interval 1.0
# No ExecStop needed: systemd sends SIGTERM by default on stop, and the
# script's own signal handler unmounts the overlay using the dri instance
# it actually detected and mounted (which could differ from a hardcoded path).
Restart=on-failure
RestartSec=5
StandardOutput=journal
User=root

# Requires raw hardware access (BAR5 mmap) and mount --bind over a sysfs
# (hwmon) file, so this cannot be sandboxed with DynamicUser/CapabilityBoundingSet.

[Install]
WantedBy=multi-user.target
